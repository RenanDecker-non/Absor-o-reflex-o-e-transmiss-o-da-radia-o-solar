:root {
  --bg: #fbfaf4;
  --text: #153e42;
  --accent: #00665f;
  --soft: #e8f1eb;
  --line: #b6c8bd;
  font-size: 18px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 2rem;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.7;
}

a {
  color: var(--accent);
  text-underline-offset: 4px;
}

a:hover {
  text-decoration-thickness: 3px;
}

header {
  padding: 1.2rem 5%;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.brand {
  font-weight: 800;
  font-size: 1.5rem;
  text-decoration: none;
  color: var(--text);
}

.brand span {
  font-weight: 400;
}

nav {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

nav a {
  font-size: 0.9rem;
}

main > section {
  padding: 4rem max(5%, calc((100% - 1180px) / 2));
  scroll-margin-top: 1rem;
}

.hero {
  display: grid;
  gap: 2rem;
  padding-top: 4rem;
  padding-bottom: 4rem;
}

.hero h1 {
  font-family: Georgia, serif;
  font-size: clamp(2.7rem, 6vw, 5rem);
  font-weight: 400;
  line-height: 1.1;
  margin: 1rem 0;
}

.hero em {
  color: var(--accent);
}

.hero p {
  max-width: 38rem;
}

.eyebrow {
  font-size: 0.75rem;
  font-weight: bold;
  letter-spacing: 0.14em;
}

.button,
button {
  display: inline-block;
  background: var(--accent);
  color: white;
  border: 2px solid var(--accent);
  padding: 0.75rem 1.1rem;
  border-radius: 6px;
  font: inherit;
  font-weight: bold;
  text-decoration: none;
  cursor: pointer;
  margin: 0.6rem 0;
}

.button:hover,
button:hover {
  filter: brightness(0.85);
}

h2 {
  font: 400 clamp(2rem, 4vw, 3rem) / 1.2 Georgia, serif;
  margin: 0.6rem 0 1.5rem;
}

h3 {
  line-height: 1.3;
}

.grid {
  display: grid;
  gap: 1.4rem;
  margin: 2rem 0;
}

.grid article {
  border-top: 2px solid var(--accent);
  padding: 1.2rem 0;
}

.number {
  font: 3rem Georgia, serif;
}

.tinted {
  background: var(--soft);
}

.split {
  display: grid;
  gap: 2rem;
  margin: 2rem 0;
}

.split > div {
  min-width: 0;
}

.solar {
  background: #d9eee5;
  border-radius: 8rem 8rem 0.5rem 0.5rem;
  padding: 2rem;
  text-align: center;
  color: #153e42;
  align-self: center;
  box-shadow: 12px 12px 0 #edd99a;
}

.sun {
  font-size: 5rem;
  color: #795000;
}

.rays {
  font-size: 2.5rem;
  letter-spacing: 1rem;
  color: #795000;
}

.cover {
  font-size: 0.65rem;
  font-weight: bold;
  border-bottom: 4px solid #fff;
  padding: 0.6rem;
}

.water {
  background: #0c696d;
  color: white;
  padding: 2rem 1rem;
  border-radius: 0 0 1rem 1rem;
}

label {
  display: block;
  font-weight: bold;
  margin-top: 1rem;
}

input,
select {
  font: inherit;
  max-width: 100%;
  width: 100%;
  padding: 0.6rem;
  background: var(--bg);
  color: var(--text);
  border: 1px solid var(--accent);
  border-radius: 4px;
}

input[type="range"] {
  padding: 0.5rem 0;
  accent-color: var(--accent);
}

output {
  float: right;
}

details {
  border-bottom: 1px solid var(--line);
  padding: 1rem 0;
}

summary {
  font-weight: bold;
  cursor: pointer;
}

.bars > div {
  margin: 1rem 0;
}

.track {
  height: 1.2rem;
  background: var(--bg);
  border: 1px solid var(--accent);
}

.fill {
  height: 100%;
  background: var(--accent);
}

.bars > div:nth-child(2) .fill {
  background: #906200;
}

.bars > div:nth-child(3) .fill {
  background: #3c6397;
}

.metric {
  padding: 1rem;
  border-left: 4px solid var(--accent);
  margin: 1rem 0;
  background: var(--soft);
}

.metric strong {
  font-size: 1.8rem;
  display: block;
}

.tablewrap {
  overflow: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

td,
th {
  padding: 0.8rem;
  border-bottom: 1px solid var(--line);
}

caption {
  text-align: left;
  font-style: italic;
}

.toolbar {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}

.video-slot {
  border: 2px dashed var(--accent);
  padding: 1rem;
  margin-top: 1rem;
}

footer {
  padding: 3rem 5%;
  background: var(--text);
  color: var(--bg);
}

footer a {
  color: var(--bg);
}

:focus-visible {
  outline: 4px solid #a54b00;
  outline-offset: 5px;
}

.skip {
  position: absolute;
  left: 1rem;
  top: -100px;
  background: white;
  padding: 1rem;
  z-index: 100;
}

.skip:focus {
  top: 1rem;
}

body.contrast {
  --bg: #000;
  --text: #fff;
  --accent: #ffe36c;
  --soft: #171717;
  --line: #fff;
}

body.contrast button,
body.contrast .button {
  color: #000;
}

body.reading {
  font-family: Verdana, Arial, sans-serif;
  letter-spacing: 0.04em;
  word-spacing: 0.1em;
  line-height: 1.95;
}

body.reading p {
  max-width: 65ch;
}

#error {
  color: #a32a16;
}

body.contrast #error {
  color: #ffb6a9;
}

@media (min-width: 800px) {
  .hero {
    grid-template-columns: 1.25fr 1fr;
  }

  .grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .split {
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
}
